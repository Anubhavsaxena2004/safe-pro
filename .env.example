# Copy this file to .env.local for local development.
# On Vercel, add the same variables under Project → Settings → Environment Variables.

# Postgres connection string (Neon, Supabase or any Postgres). Use the POOLED url.
# POSTGRES_URL is also accepted (Vercel's Neon/Supabase integrations set it).
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Random secret, 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# First admin login. Used only while no admin exists yet; after the first
# login the account lives in the database and more admins can be added in Settings.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# OTP for mobile numbers (Safe Pro login/registration, customer bookings).
#   demo (default): the code is shown on screen, no SMS is sent. For testing only.
#   live: sends a real SMS. Connect a DLT-registered provider in lib/providers.ts first.
OTP_MODE=demo

# Aadhaar verification during Safe Pro registration.
#   demo (default): simulated, the OTP is shown on screen and nothing is sent to UIDAI.
#   live: needs a UIDAI-licensed e-KYC partner connected in lib/providers.ts.
AADHAAR_MODE=demo

# Vercel Blob token for KYC documents and job photos. Vercel sets this
# automatically when you connect a Blob store to the project.
# Without it (local dev), photos are stored inside the database instead.
BLOB_READ_WRITE_TOKEN=
# "private" (recommended: KYC and in-home photos) or "public". Must match the store type.
BLOB_ACCESS=private

# Extra websites allowed to send booking requests from the browser, comma-separated.
# Already allowed: https://kiddough.in, https://www.kiddough.in, https://*.shopifypreview.com
# Add the store's myshopify address if you test there, e.g.:
# ALLOWED_ORIGINS=https://kiddough-store.myshopify.com
ALLOWED_ORIGINS=

# Optional: lets a server (not a browser) send requests, e.g. Shopify Flow or a script.
# Send it in the X-Api-Key header. Never put this in theme code (it would be public).
INTAKE_API_KEY=
